Table gold_fato_chamados {
  id_chamado bigint [primary key]
  id_atendente bigint
  id_cliente bigint
  nome_motivo_clean string
  resolvido boolean
  nome_canal string
  bronze_ingestion_timestamp timestamp
  silver_ingestion_timestamp timestamp
  data_hora_abertura timestamp
  data_hora_inicio_atendimento timestamp
  data_hora_finalizacao_atendimento timestamp
  tempo_espera_atendimento_min double
  tempo_atendimento_min double
  ano integer
  mes integer
  dia integer
  dia_semana_num int
  nome_dia string
  trimestre int
  semana_do_ano int
  flag_fim_de_semana boolean
  ciclo_operacional string
  evento_sazonal string
  nota_atendimento int
  valor_custo decimal(18,10)
  hora_dia int
}


Table gold_table_kpis_por_horario {
hora_dia int
qtd_chamados bigint
nota_media double
custo_total decimal(18,10)
custo_medio_por_chamado decimal(18,10)
idade_media_cliente double
canal_mais_usado varchar
}

Table gold_table_kpis_dia_semana {
  dia_semana_num int
  nome_dia string
  qtd_chamados bigint
  nota_media double
  custo_total decimal(18,10)
  custo_medio_por_chamado decimal(18,10)
  idade_media_cliente double
  canal_mais_usado varchar
}

Table gold_table_kpis_semana_mes {
  ano integer
  mes integer
  semana_mes integer
  qtd_chamados bigint
  nota_media double
  custo_total decimal(18,10)
  custo_medio_por_chamado decimal(18,10)
  idade_media_cliente double
  canal_mais_usado varchar
}

Table gold_table_kpis_mes {
  ano integer
  mes integer
  qtd_chamados bigint
  nota_media double
  custo_total decimal(18,10)
  custo_medio_por_chamado decimal(18,10)
  idade_media_cliente double
  canal_mais_usado varchar
}


Table gold_fato_desempenho_canal {
  id_chamado bigint [primary key]
  id_cliente bigint
  id_atendente bigint
  nome_canal varchar
  resolvido boolean
  motivo string
  categoria_motivo string
  criticidade_motivo string
  valor_custo decimal(18,10)
  nota_atendimento int
  gold_ingestion_timestamp timestamp
}

Table gold_fato_experiencia_cliente {
  id_chamado bigint [primary key]
  id_cliente bigint
  nome string
  faixa_etaria_geracao string
  flag_idoso int
  regiao string
  canal_utilizado varchar
  resolvido boolean
  nota_atendimento int
  flag_sucesso int
  flag_respondeu_pesquisa int
}

Table gold_dim_motivos_criticos {
  motivo string
  categoria_motivo string
  criticidade_motivo string
  qtd_chamados bigint
  csat_medio double
  tme_medio double
  custo_total decimal(18,10)
  ranking_prioridade int
}

Table gold_view_desempenho_atendentes {
  id_atendente integer
  nome_atendente string
  nivel_atendimento integer
  descricao_nivel string
  qtd_atendimentos long
  tempo_medio_atendimento_min double
  tempo_total_trabalhado_min double
  taxa_resolucao double
  nota_media double
  custo_medio_atendente decimal(11,2)
  custo_total_atendente decimal(21,2)
}

Table gold_view_analise_custos_motivos {
  motivo string
  categoria_motivo string
  volume_chamados long
  custo_total decimal(10,2)
  custo_medio_por_chamado decimal(10,2)
  tma_medio decimal(10,2)
  pct_custo_total decimal(35,2)
}

Table gold_view_analise_custos_regiao {
  regiao string
  volume_chamados long
  custo_total decimal(10,2)
  custo_medio_por_chamado decimal(10,2)
  tma_medio decimal(10,2)
  pct_custo_total decimal(35,2)
}

Table gold_view_canais {
  canal string
  volume_chamados long
  taxa_resolucao_pct double
  taxa_potencial_transferencia_pct double
  csat_medio double
  tma_medio decimal(10,2)
  custo_total decimal(10,2)
  custo_medio_por_chamado decimal(10,2)
  pct_custo_total decimal(35,2)
}

Table gold_view_comparativo_humano_robo {
  tipo_atendimento string
  volumetria long
  qtd_pesquisas_respondidas long
  csat_medio double
  taxa_resolucao_pct double
  custo_total_acumulado decimal(21,2)
  custo_medio_unitario decimal(13,4)
}


Table gold_view_diagnostico_bots {
  nome_canal string
  complexidade string
  tentativas long
  taxa_sucesso_pct double
  satisfacao_usuario double
}

Table gold_view_analise_geracoes_tech {
  faixa_etaria_geracao string
  canal_utilizado string
  total_interacoes long
  csat_medio double
  taxa_resolucao_pct double
  qtd_pesquisas_respondidas long
}

Table gold_view_jornada_cliente_360 {
  id_cliente long
  nome string
  faixa_etaria_geracao string
  regiao string
  canal_mais_usado string
  qtd_chamados_total long
  qtd_falhas_resolucao long
  taxa_sucesso_pessoal_pct double
  csat_medio_pessoal double
}


Table gold_view_kpi_criticidade {
  criticidade_motivo string
  qtd_chamados long
  nota_media double
  tempo_espera_medio_min double
  tempo_atendimento_medio_min double
  custo_total decimal(21,2)
  custo_medio_por_chamado decimal(11,2)
  idade_media double
  qtd_resolvidos long
  
  // Métricas Calculadas Gerais
  qtd_nao_resolvidos long
  perc_resolvidos double
  perc_nao_resolvidos double

  // Métricas de Nível 1
  qtd_chamados_nivel_1 long
  qtd_resolvidos_nivel_1 long
  qtd_nao_resolvidos_nivel_1 long
  taxa_resolucao_nivel_1 double
  perc_chamados_nivel_1 double

  // Métricas de Nível 2
  qtd_chamados_nivel_2 long
  qtd_resolvidos_nivel_2 long
  qtd_nao_resolvidos_nivel_2 long
  taxa_resolucao_nivel_2 double
  perc_chamados_nivel_2 double
}
