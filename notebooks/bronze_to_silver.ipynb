    "# Lendo a tabela chamados_hora da camada bronze e visualizando os primeiros registros\n",
    "df_bz = spark.table(\"bronze.chamados_hora\")\n",
    "print(f\"bronze.chamados_hora: {df_bz.count()} rows\")\n",
    "display(df_bz.limit(10))"
